# Base URL de api-vendedores (mismo backend que app-vendedores)
VITE_API_URL=
# URL del servicio de auth (login / validate token)
VITE_API_AUTH_URL=https://apidistri.distrisuper.com

# Alimenta /analitica y /analitica/actividad con el fixture de src/mocks/analiticaMock.ts
# en lugar del backend. El fixture cubre una semana histórica (2026-07-20 a 2026-07-24)
# MÁS el día de hoy, así la vista de actividad no abre vacía en su propio default.
# Fase 1: en 1. Se apaga cuando api-vendedores exponga /planificacion/analitica/*.
VITE_ANALITICA_MOCK=1
