{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Calendar/**",
              "components/general/Card/**",
              "components/general/Drawer/**",
              "components/general/DropdownMenu/**",
              "components/general/ExportButton/**",
              "components/general/Input/**",
              "components/general/LoadingSpinner/**",
              "components/general/Popover/**",
              "components/general/ScrollArea/**",
              "components/general/Select/**",
              "components/general/Separator/**",
              "components/general/Sheet/**",
              "components/general/Skeleton/**",
              "components/general/Table/**",
              "components/general/Tabs/**",
              "components/general/Textarea/**",
              "components/general/Tooltip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
