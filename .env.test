# Valores para la suite de tests (Vite carga este archivo en mode 'test'). Trackeado a
# propósito: los tests no pueden depender del .env local de cada máquina, que está
# gitignoreado y no existe en CI ni en un clone fresco. Solo valores públicos.

# appsExternas.ts construye la URL de handoff con esta base; sin ella la app "pagos" no
# entra al registro (APPS_EXTERNAS la filtra) y los tests que la buscan no la encuentran.
VITE_PAGOS_LUPA_URL=https://pagos-lupa.web.app

# appsExternas.ts construye la URL de handoff con esta base; sin ella la app "versus" no
# entra al registro (APPS_EXTERNAS la filtra) y los tests que la buscan no la encuentran.
VITE_VERSUS_URL=https://versus-v2.distrisuper.com
