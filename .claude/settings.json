{
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:hooks)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)"
    ],
    "ask": [
      "Edit(/src/lib/roles.ts)",
      "Edit(/src/router/ProtectedRoute.tsx)",
      "Edit(/src/context/AuthContext.tsx)",
      "Edit(/src/api/authApi.ts)",
      "Edit(/src/api/apiClient.ts)",
      "Edit(/src/lib/sesionLocal.ts)",
      "Edit(/src/utils/initialURLCapture.ts)",
      "Edit(/src/main.tsx)",
      "Edit(/.github/workflows/**)",
      "Edit(/vercel.json)"
    ],
    "deny": [
      "Read(/.env)",
      "Edit(/.env)",
      "Read(/.env.local)",
      "Edit(/.env.local)",
      "Read(/.env.bak)",
      "Edit(/.env.bak)",
      "Read(/.env.test)",
      "Edit(/.env.test)",
      "Read(/.env.development)",
      "Edit(/.env.development)",
      "Read(/.env.development.local)",
      "Edit(/.env.development.local)",
      "Read(/.env.production)",
      "Edit(/.env.production)",
      "Read(/.env.production.local)",
      "Edit(/.env.production.local)",
      "Read(/.env-prod)",
      "Edit(/.env-prod)",
      "Read(/.env-staging)",
      "Edit(/.env-staging)",
      "Read(/.env.tunnel)",
      "Edit(/.env.tunnel)",
      "Read(/agente*.env)",
      "Edit(/agente*.env)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.git-credentials)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh pr review -a:*)",
      "Bash(gh auth token:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(vercel:*)",
      "Bash(vc:*)",
      "Bash(npx vercel:*)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase-tools deploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
